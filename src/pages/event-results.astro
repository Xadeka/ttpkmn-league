---

<DefaultLayout>
  <div class="mb-4 flex">
    <a
      class="hover:bg-link-hover hover:text-bg outline-link-hover rounded-md px-3 py-1 outline transition-colors duration-150"
      href="/"
    >
      ← Back
    </a>
  </div>
  <div class="m-auto max-w-2xl">
    <h1>Past Tournament Results</h1>
    {events.map((event) => {
      return (
        <Card class="flex items-center justify-between">
          {event.title} &ndash; {event.date}
          <div class="flex gap-2">
            <a
              class="outline-link-hover rounded-full px-3 py-1 outline"
              href={event.resultsHref}
            >
              Results
            </a>
            <a
              class={cn("outline-link-hover rounded-full px-3 py-1 outline", {
                invisible: event.decklistsHref === null,
              })}
              href={event.decklistsHref}
            >
              Decklists
            </a>
          </div>
        </Card>
      );
    })}
  </div>
</DefaultLayout>
