---
import { getCollection, type CollectionEntry } from "astro:content";
import DefaultLayout from "../../../layout/DefaultLayout.astro";
import Card from "../../../components/Card.astro";
import Lightbox from "../../../components/Lightbox.astro";

export async function getStaticPaths() {
  const events = await getCollection("events");
  return events
    .map((event) => {
      if (event.data.decklists.length === 0) {
        return null;
      }
      return {
        params: { eventId: event.id },
        props: event,
      };
    })
    .filter((event) => event !== null);
}

type Props = CollectionEntry<"events">;
const props = Astro.props;
const event = props.data;

function getPlacementText(placement: number) {
  switch (placement) {
    case 1:
      return "1st";
    case 2:
      return "2nd";
    case 3:
      return "3rd";
    default:
      return placement + "th";
  }
}
---

<DefaultLayout title={event.description + " Results"}>
  <div class="mb-4 flex">
    <a
      class="hover:bg-link-hover hover:text-bg outline-link-hover rounded-md px-3 py-1 outline transition-colors duration-150"
      href="/event-results"
    >
      ← Back
    </a>
  </div>
  <div class="m-auto max-w-3xl">
    <h2 class="mb-0 text-center">{event.title}</h2>
    <h3 class="text-muted mb-6 text-center">
      {event.description} • {event.eventDate}
    </h3>
    {event.decklists.map((decklist) => {
      const placement = getPlacementText(decklist.placement);
      return (
        <Card class="overflow-hidden p-0">
          <img
            src={`/event-results/${props.id}/${decklist.placement}.png`}
            alt=""
            data-lightbox-image
            data-lightbox-caption={`${placement} Place — ${decklist.playerName} • ${decklist.deckName}`}
          />
          <div class="flex flex-col p-4">
            <span class="text-link font-bold">{placement} Place</span>
            <span class="text-lg font-bold">{decklist.playerName}</span>
            <span class="text-muted">{decklist.deckName}</span>
          </div>
        </Card>
      );
    })}
  </div>
  <Lightbox />
</DefaultLayout>
