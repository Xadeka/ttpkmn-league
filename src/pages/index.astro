---
import DefaultLayout from "../layout/DefaultLayout.astro";
import Card from "../components/Card.astro";
import ScheduledEventText from "../components/ScheduledEventText.astro";
import ChampionshipPointsCard from "../components/ChampionshipPointsCard.astro";
import FontAwesomeIcon from "../components/FontAwesomeIcon.astro";
import { faDiscord, faTwitter } from "@fortawesome/free-brands-svg-icons";
---

<DefaultLayout>
  <div class="m-auto max-w-150">
    <h1>Time Travelers Pokemon League</h1>
    <Card>
      <h2>Quick Links</h2>
      <ul class="space-y-1">
        <li>
          <a
            href="https://timetravelersonline.com/products/pokemon-fall-league-cup-masters-entry-11-14-25-sat-11pm"
            target="_blank"
          >
            💵 League Cup Registration (Masters)
          </a>
        </li>
        <li>
          <a
            href="https://timetravelersonline.com/products/pokemon-fall-league-cup-jnr-snr-entry-11-14-25-sat-11pm"
            target="_blank"
          >
            💵 League Cup Registration (Juniors/Seniors)
          </a>
        </li>
        <li>
          <a href="https://forms.gle/cAmh8MULthNzee1V9" target="_blank">
            🃏 Decklist Submission
          </a>
        </li>
        <li hidden>
          <a href="pairings.html" target="_blank">
            🔗 Pairings
          </a>
        </li>
        <li>
          <a href="pairings-default">🔗 Pairings</a>
        </li>
        <li hidden>
          <a href="standings.html" target="_blank">
            📊 Standings
          </a>
        </li>
        <li hidden>
          <a href="https://forms.gle/mbcM8xtzFN6HCDUk6" target="_blank">
            ✍️ Post Event Survey
          </a>
        </li>
        <li>
          <a href="https://discord.gg/bQNVEmvh4u" target="_blank">
            <FontAwesomeIcon icon={faDiscord} class="text-discord" /> Time
            Travelers Discord
          </a>
        </li>
        <li>
          <a href="https://x.com/TTPKMN" target="_blank">
            <FontAwesomeIcon icon={faTwitter} class="text-twitter" /> League
            Twitter
          </a>
        </li>
        <li>
          <a href="event-results">🏆 Past Event Results</a>
        </li>
      </ul>
    </Card>

    <Card>
      <h2>Wi-Fi Info</h2>
      <p>
        <span class="font-bold">Network:</span> Time Travelers_Guest
      </p>
      <p>
        <span class="font-bold">Password:</span> TT_Guest
      </p>
    </Card>

    <Card>
      <h2>Season 1 League Cup</h2>
      <p>
        <span class="font-bold">Location:</span> 3116 12 Mile Road, Berkley, MI
        48072
      </p>
      <p>
        <span class="font-bold">Date:</span> November 14, 2026
      </p>
      <p>
        <span class="font-bold">Time:</span> Round 1 starts at 11:05 AM. Store
        opens at 10:00 AM.
        <br />
        If you do not have your decklist submitted by 11:00 AM, you will receive
        a loss for round 1.
      </p>
      <p>
        <span class="font-bold">Cost:</span> $20 for Masters, $10 for
        Juniors/Seniors
      </p>
      <p>
        <span class="font-bold">Rounds:</span> X Swiss rounds &ndash; best of
        one &ndash; 30 minutes + 3 turns
        <br />
        Top 8 cut &ndash; best of three &ndash; 60 minutes + 3 turns
      </p>
      <p>
        <span class="font-bold">Prizing:</span> Masters &ndash; Store credit and
        prize packs to top 8
        <br />
        Juniors/Seniors &ndash; Booster packs and prize packs
      </p>
      <p>
        <span class="font-bold">Staff:</span> Conor Devins, Russell Culver, Zade
        Kaakarni
      </p>
    </Card>

    <Card>
      <h2>Upcoming Events</h2>
      <ScheduledEventText datetime="2026-11-14 11:00" type="cup" />
      <ScheduledEventText datetime="2026-11-21 11:30" type="league" />
      <ScheduledEventText datetime="2026-11-28 12:00" type="challenge" />
      <ScheduledEventText datetime="2026-12-05 11:30" type="league" />
    </Card>

    <ChampionshipPointsCard type="cup" />
  </div>
</DefaultLayout>
